# Discord bot token (Developer Portal → Bot → Reset Token)
TOKEN=

# Discord application/client id (Developer Portal → General Information)
CLIENT_ID=

# Comma-separated trigger words for the hello text reply (case-insensitive)
HELLO_WORDS=hello,hi,salut,bonjour

# Comma-separated trigger words that play "Non.mp3" when the author is in voice
NO_WORDS=no,non,nope,nan

# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
